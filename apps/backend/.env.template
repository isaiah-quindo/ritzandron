STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:8000

# Database
# Local (docker compose):
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/ritzandron
#   DATABASE_SSL=false
#
# Supabase (production): project > Connect > "Session pooler", which has the
# form below. Use port 5432 (session mode), not the transaction pooler (6543),
# which breaks Medusa's migrations and locks. The "Direct connection" host
# (db.<project-ref>.supabase.co) is IPv6-only unless you buy the IPv4 add-on,
# so most hosts can't reach it; the session pooler works over IPv4.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres
#   DATABASE_SSL=true
# <pooler-host> looks like aws-0-ap-southeast-2.pooler.supabase.com; copy it
# from the Connect dialog. URL-encode special characters in <db-password>
# (e.g. @ -> %40, # -> %23), or reset it to letters and numbers only
# (project > Settings > Database > Reset database password).
DATABASE_URL=
DATABASE_SSL=false

# Redis (optional locally; required in production). `docker compose up -d`
# REDIS_URL=redis://localhost:6379

# Supabase Storage (S3-compatible) for product images. Leave S3_BUCKET empty
# to store uploads on local disk.
# 1. Storage > New bucket: name it product-images and turn on "Public bucket"
#    (the storefront loads images straight from S3_FILE_URL).
# 2. Storage > Settings > S3 Connection: copy the endpoint and region, then
#    "New access key" for the key ID and secret (the secret is shown once).
# 3. S3_FILE_URL isn't shown by Supabase: build it from the endpoint by
#    replacing the trailing /s3 with /object/public/<bucket>. It's the public
#    URL Medusa prefixes to each uploaded image's filename.
# <project-ref> is the ID in your project URL (also in Settings > General).
S3_BUCKET=
S3_REGION=ap-southeast-2
S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
S3_FILE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/product-images
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Square (developer.squareup.com > Apps > Credentials)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
# Capture immediately when the order is placed (true) or authorize only (false)
SQUARE_AUTO_CAPTURE=true
# Webhook subscription for payment.updated -> {MEDUSA_BACKEND_URL}/hooks/payment/square_square
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Resend. Without RESEND_API_KEY emails are printed to the server log.
RESEND_API_KEY=
RESEND_FROM=Ritz & Ron <orders@ritzandron.com.au>
RESEND_REPLY_TO=hello@ritzandron.com.au
# Mailtrap sandbox for local dev: when both are set, all email goes to the
# Mailtrap test inbox instead of Resend. Leave empty in production.
# Mailtrap > Sandboxes > your inbox: ID is the number in the URL; token under API.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=

# Sanity product sync (token with Editor permissions)
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_WRITE_TOKEN=

# Shared with the storefront's /api/revalidate route
REVALIDATE_SECRET=
