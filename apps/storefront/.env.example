# Medusa
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Admin > Settings > Publishable API Keys ("Storefront", created by the seed)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_DEFAULT_REGION=au
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Square Web Payments SDK (same Square app as the backend; sandbox app IDs start with "sandbox-")
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Sanity (Studio at /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
# Sanity webhook (GROQ projection: {_type}) -> {NEXT_PUBLIC_BASE_URL}/api/revalidate
SANITY_WEBHOOK_SECRET=
# Shared with the backend so product edits refresh the storefront
REVALIDATE_SECRET=

# Resend: newsletter signups and the contact form
RESEND_API_KEY=
RESEND_FROM=Ritz & Ron <orders@ritzandron.com.au>
RESEND_NEWSLETTER_SEGMENT_ID=
# Mailtrap sandbox for local dev: when both are set, all email goes to the
# Mailtrap test inbox instead of Resend. Leave empty in production.
# Mailtrap > Sandboxes > your inbox: ID is the number in the URL; token under API.
MAILTRAP_API_TOKEN=
MAILTRAP_INBOX_ID=
CONTACT_EMAIL=hello@ritzandron.com.au
